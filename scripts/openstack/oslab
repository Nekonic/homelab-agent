#!/usr/bin/python3 -I
"""oslab - strict allow-list wrapper around the OpenStack CLI for AI ops bots.

Only a small set of read/create/power commands is passed through. Everything else
(delete, rebuild, resize, set, unset, ...) is refused here, and is ALSO refused
server-side by the Nova policy and the application credential's access rules.

  oslab server list|show|start|stop|reboot ...
  oslab server create lab-<name> --image I --flavor F --network N [--user-data ~/lab-userdata/x.yaml] ...
  oslab console log show <server> [--lines N]
  oslab {network|subnet|port|router|security group|security group rule|floating ip} list|show ...
  oslab {network|subnet|port|router|security group} create lab-<name> [options]
  oslab security group rule create lab-<group> [options]
  oslab floating ip create provider [options]
  oslab router add subnet lab-<router> lab-<subnet>
  oslab router set lab-<router> --external-gateway provider
  oslab image list|show, flavor list|show, quota show, limits show

Rules: always --os-cloud lab-agent; no --os-*/--debug/--log-file style global options;
no server/port directly on the external (provider) network;
created resources must be named lab-*; exec() with an argument list (no shell).
"""
import os
import re
import sys

HOME = os.path.expanduser("~")
OPENSTACK = os.path.join(HOME, ".venvs/openstack/bin/openstack")
CLOUDS_YAML = os.path.join(HOME, ".config/openstack/clouds.yaml")
USERDATA_DIR = os.path.realpath(os.path.join(HOME, "lab-userdata"))
CLOUD = "lab-agent"
EXTERNAL_NET = "provider"
# The external network is also "shared", so Neutron/Nova would let a member put a VM
# NIC directly on the user's LAN. oslab refuses that: VMs/ports go on lab-* networks
# or lab-bridge; the LAN is reachable only via router gateway + floating IP.
EXTERNAL_NET_IDS = {EXTERNAL_NET, "<PROVIDER_NET_ID>"}  # <- openstack network show provider -f value -c id

NAME_RE = re.compile(r"^lab-[A-Za-z0-9._-]{1,60}$")
UUID_RE = re.compile(r"^[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}$")

# Global options of the openstack CLI that must never be supplied by the caller.
# cliff parses global options anywhere in argv and argparse accepts unambiguous
# prefixes, so any token that is a prefix of one of these is rejected.
GLOBAL_DENY = [
    "--debug", "--log-file", "--verbose", "--quiet", "--insecure", "--verify",
    "--profile", "--timing", "--version", "--help", "--os-",
]
# Per-command options that are refused (prefix-matched as well).
SERVER_CREATE_DENY = ["--file", "--hint", "--host", "--hypervisor-hostname",
                      "--availability-zone", "--config-drive-file"]
USER_DATA_OPT = "--user-data"

# resource words -> canonical resource (1-3 tokens)
RESOURCES = {
    ("server",): "server",
    ("network",): "network",
    ("subnet",): "subnet",
    ("port",): "port",
    ("router",): "router",
    ("security", "group"): "security group",
    ("security", "group", "rule"): "security group rule",
    ("floating", "ip"): "floating ip",
    ("image",): "image",
    ("flavor",): "flavor",
    ("quota",): "quota",
    ("limits",): "limits",
    ("console", "log"): "console log",
}

ALLOWED_ACTIONS = {
    "server": {"list", "show", "create", "start", "stop", "reboot"},
    "network": {"list", "show", "create"},
    "subnet": {"list", "show", "create"},
    "port": {"list", "show", "create"},
    "router": {"list", "show", "create", "add", "set"},
    "security group": {"list", "show", "create"},
    "security group rule": {"list", "show", "create"},
    "floating ip": {"list", "show", "create"},
    "image": {"list", "show"},
    "flavor": {"list", "show"},
    "quota": {"show"},
    "limits": {"show"},
    "console log": {"show"},
}


def die(msg, code=2):
    sys.stderr.write("oslab: " + msg + "\n")
    sys.exit(code)


def opt_name(tok):
    return tok.split("=", 1)[0]


def is_prefix_of_any(tok, names):
    """True if long option `tok` (or --x=y) is a prefix of / equal to any denied name."""
    if not tok.startswith("--"):
        return False
    name = opt_name(tok)
    if len(name) < 3:
        return True  # bare "--" or "--x"
    for n in names:
        if n.endswith("-") and name.startswith(n):  # whole family, e.g. --os-*
            return True
        if n.startswith(name):
            return True
    return False


def check_tokens(args):
    for a in args:
        if "\x00" in a or "\n" in a or "\r" in a:
            die("control characters are not allowed in arguments")
        if a == "--" or a.startswith("@"):
            die("argument %r is not allowed" % a)
        if is_prefix_of_any(a, GLOBAL_DENY):
            die("global option %r is not allowed (cloud/auth/debug are fixed by oslab)" % a)


def need_lab_name(value, what):
    if not NAME_RE.match(value):
        die("%s must be named 'lab-...' ([A-Za-z0-9._-], max 64 chars), got %r" % (what, value))


def need_lab_or_uuid(value, what):
    if not (NAME_RE.match(value) or UUID_RE.match(value)):
        die("%s must be a 'lab-...' name or a UUID, got %r" % (what, value))


def check_user_data(args):
    """--user-data is only allowed from files under ~/lab-userdata/."""
    out = list(args)
    for i, a in enumerate(args):
        if a.startswith("--") and len(opt_name(a)) >= 4 and USER_DATA_OPT.startswith(opt_name(a)):
            if "=" in a:
                path = a.split("=", 1)[1]
            else:
                if i + 1 >= len(args):
                    die("--user-data needs a file")
                path = args[i + 1]
            real = os.path.realpath(os.path.expanduser(path))
            if not real.startswith(USERDATA_DIR + os.sep) or not os.path.isfile(real):
                die("--user-data file must be inside %s/" % USERDATA_DIR)
    return out


def build(argv):
    if not argv or argv[0] in ("-h", "help"):
        print(__doc__.strip())
        sys.exit(0)
    check_tokens(argv)

    res = None
    for n in (3, 2, 1):
        key = tuple(argv[:n])
        if key in RESOURCES:
            res, rest = RESOURCES[key], argv[n:]
            break
    if res is None:
        die("command not allowed: %r" % " ".join(argv[:3]))
    if not rest:
        die("missing action for %r" % res)
    action, rest = rest[0], rest[1:]
    if action not in ALLOWED_ACTIONS[res]:
        die("'%s %s' is not allowed. Deletes/rebuilds/resizes/changes are done by the human." % (res, action))

    head = res.split() + [action]

    if action == "create":
        if res == "floating ip":
            if not rest or rest[0] != EXTERNAL_NET:
                die("floating ip create: first argument must be the external network '%s'" % EXTERNAL_NET)
            return head + rest[1:] + [EXTERNAL_NET]
        if not rest:
            die("%s create: first argument must be the lab-... name" % res)
        name, opts = rest[0], rest[1:]
        if res == "security group rule":
            need_lab_or_uuid(name, "security group")
        else:
            need_lab_name(name, res)
        if res in ("server", "port"):
            for a in opts:
                vals = [a, a.split("=", 1)[-1]] + [kv.split("=", 1)[-1] for kv in a.split(",")]
                if any(v in EXTERNAL_NET_IDS for v in vals):
                    die("VM NICs/ports on the external network '%s' are not allowed; "
                        "use a lab-* network or lab-bridge (+ router/floating ip)" % EXTERNAL_NET)
        if res == "server":
            for a in opts:
                if is_prefix_of_any(a, SERVER_CREATE_DENY):
                    die("server create option %r is not allowed" % a)
            opts = check_user_data(opts)
        # positional (name/group) goes last; extra positionals make the CLI fail
        return head + opts + [name]

    if res == "router" and action == "add":
        if len(rest) != 3 or rest[0] != "subnet":
            die("usage: oslab router add subnet lab-<router> lab-<subnet>")
        need_lab_or_uuid(rest[1], "router")
        need_lab_or_uuid(rest[2], "subnet")
        return ["router", "add", "subnet", rest[1], rest[2]]

    if res == "router" and action == "set":
        if len(rest) != 3 or rest[1] != "--external-gateway" or rest[2] != EXTERNAL_NET:
            die("usage: oslab router set lab-<router> --external-gateway %s" % EXTERNAL_NET)
        need_lab_or_uuid(rest[0], "router")
        return ["router", "set", "--external-gateway", EXTERNAL_NET, rest[0]]

    if res == "server" and action in ("start", "stop", "reboot"):
        targets = [a for a in rest if not a.startswith("-")]
        if not targets:
            die("server %s: name the server(s)" % action)
        for t in targets:
            need_lab_or_uuid(t, "server")
        return head + rest

    # list / show / quota show / limits show / console log show
    return head + rest


def main():
    cmd = build(sys.argv[1:])
    if not os.path.isfile(OPENSTACK):
        die("openstack client not found at %s" % OPENSTACK, 1)
    env = {k: v for k, v in os.environ.items()
           if k in ("PATH", "HOME", "LANG", "LC_ALL", "TERM", "USER", "LOGNAME", "COLUMNS")}
    env["OS_CLIENT_CONFIG_FILE"] = CLOUDS_YAML
    env["PYTHONNOUSERSITE"] = "1"
    argv = [OPENSTACK, "--os-cloud", CLOUD] + cmd
    os.execve(OPENSTACK, argv, env)


if __name__ == "__main__":
    main()
