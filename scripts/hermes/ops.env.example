# Append to ~/.hermes/.env on lab-assistant (ops = default profile).  chmod 600 ~/.hermes/.env
# Never commit the real file.

# --- LLM providers (primary: ChatGPT plan via `hermes auth add openai-codex`, no key here) ---
OPENROUTER_API_KEY=<OPENROUTER_API_KEY>
OPENCODE_ZEN_API_KEY=<OPENCODE_ZEN_API_KEY>

# --- Discord: ops bot (its own bot application/token) ---
DISCORD_BOT_TOKEN=<OPS_DISCORD_BOT_TOKEN>
DISCORD_ALLOWED_USERS=<YOUR_DISCORD_USER_ID>
DISCORD_IGNORED_CHANNELS=*        # DMs only
DISCORD_ALLOW_BOTS=none

# --- MCP credentials (ops only) ---
GNS3_API_KEY=<gns3_xxx API key named "hermes">
WINDOWS_MCP_AUTH_KEY=<random 32+ bytes, same value as auth_key in Windows ~/.windows-mcp/config.toml>
VNC_PASSWORD=<VNC_PASSWORD>
