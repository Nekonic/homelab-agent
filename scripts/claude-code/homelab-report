#!/bin/bash
# homelab-report — 매일 홈랩 점검을 Claude Code(-p)로 돌리고 결과를 Discord #claude 포럼에 새 글로 올린다.
# systemd user timer(homelab-report.timer)가 실행한다. 수동 실행: homelab-report
set -u
FORUM_ID="${HOMELAB_REPORT_FORUM_ID:?set HOMELAB_REPORT_FORUM_ID}"
TOKEN=$(grep -E '^DISCORD_BOT_TOKEN=' "$HOME/.claude/channels/discord/.env" | cut -d= -f2-)
LOG_DIR="$HOME/.local/state/homelab-report"; mkdir -p "$LOG_DIR"
if [ -z "$TOKEN" ]; then
  printf '===== %s DISCORD_BOT_TOKEN missing in ~/.claude/channels/discord/.env — report skipped\n' "$(date -Is)" >> "$LOG_DIR/report.log"
  echo "homelab-report: DISCORD_BOT_TOKEN missing — skipped" >&2
  exit 1
fi
DAY=$(date +%F)
PROMPT=$(cat <<'P'
홈랩 일일 점검 리포트를 작성해라. **조회만 하고 아무것도 바꾸지 마라**(켜기·끄기·삭제·재시작 금지, 윈도우 VM이 꺼져 있으면 켜지 마라).
확인할 것:
1. `osadmin server list --all-projects --long` — VM 상태, 잠금 여부. `lab-` 로 시작하는 실습 VM이 있으면 이름·나이·상태를 적고 "정리 필요?"로 표시.
2. `osadmin hypervisor stats show` — 메모리·vCPU·디스크 사용/여유.
3. `systemctl --user is-active hermes-gateway claude-discord` 와 `journalctl --user -u hermes-gateway --since -24h -p warning --no-pager | tail -n 30` 의 요점.
4. `ssh winpower status`.
5. `~/.local/state/osadmin/audit.log` 에서 지난 24시간 호출 요약(몇 건, 어떤 종류, 실패 몇 건). 삭제·잠금해제가 있었으면 명시.
6. 이 VM의 `df -h /`, `free -h`.
형식: 한국어, 맨 위에 한 줄 요약(✅ 이상 없음 / ⚠️ 확인 필요 n건), 그다음 항목별 짧은 목록. 전체 1500자 이내. 비밀값·토큰은 절대 출력하지 마라.
P
)
cd "$HOME/claude-work" || exit 1
OUT=$(timeout 900 "$HOME/.local/bin/claude" -p "$PROMPT" --max-turns 40 --output-format text \
  --settings '{"enabledPlugins":{"discord@claude-plugins-official":false}}' < /dev/null 2>&1)
RC=$?
printf '%s\n===== %s exit=%s\n%s\n' "" "$(date -Is)" "$RC" "$OUT" >> "$LOG_DIR/report.log"
[ $RC -ne 0 ] && OUT="⚠️ 점검 실행 실패 (exit $RC). 비서 VM의 ~/.local/state/homelab-report/report.log 를 확인하세요.
$(printf '%s' "$OUT" | tail -c 800)"

TOKEN="$TOKEN" FORUM_ID="$FORUM_ID" TITLE="홈랩 점검 $DAY" BODY="$OUT" python3 - <<'PY'
import json, os, urllib.request
tok, forum = os.environ["TOKEN"], os.environ["FORUM_ID"]
body = os.environ["BODY"].strip() or "(빈 결과)"
chunks, cur = [], ""
for line in body.splitlines(keepends=True):          # Discord limit 2000 chars per message
    if cur and len(cur) + len(line) > 1900:
        chunks.append(cur); cur = ""
    cur += line[:1900]
chunks.append(cur)
def call(url, payload):
    req = urllib.request.Request(url, data=json.dumps(payload).encode(), method="POST",
          headers={"Authorization": f"Bot {tok}", "Content-Type": "application/json", "User-Agent": "homelab-report"})
    return json.load(urllib.request.urlopen(req, timeout=30))
api = "https://discord.com/api/v10"
NO_PINGS = {"parse": []}   # never ping @everyone/roles/users from model output
post = call(f"{api}/channels/{forum}/threads",
            {"name": os.environ["TITLE"], "message": {"content": chunks[0], "allowed_mentions": NO_PINGS}})
for c in chunks[1:]:
    call(f"{api}/channels/{post['id']}/messages", {"content": c, "allowed_mentions": NO_PINGS})
print("posted", post["id"], "chunks", len(chunks))
PY
