[Unit]
Description=GNS3 server
After=network-online.target libvirtd.service
Wants=network-online.target

[Service]
Type=simple
User=gns3
Group=gns3
ExecStart=/home/gns3/venv/bin/gns3server --config /home/gns3/.config/GNS3/3.1/gns3_server.conf
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
