#!/bin/bash
# homelab-report: 홈랩 일일 점검을 Claude Code(-p)로 실행하고 결과를 Discord #claude 포럼에 새 글로 올린다.
# systemd user timer(homelab-report.timer)가 실행한다. 수동 실행: homelab-report
# 테스트: HOMELAB_REPORT_DRY_RUN=1 → 올리지 않고 청크 크기만 출력.
#         HOMELAB_REPORT_BODY_FILE=<파일> → claude 대신 그 파일을 본문으로 쓰고(로그에도 안 남김) 항상 dry-run.
set -u
FORUM_ID="${HOMELAB_REPORT_FORUM_ID:?set HOMELAB_REPORT_FORUM_ID}"
TOKEN=$(grep -m1 -E '^DISCORD_BOT_TOKEN=' "$HOME/.claude/channels/discord/.env" | cut -d= -f2-)
LOG_DIR="$HOME/.local/state/homelab-report"; mkdir -p "$LOG_DIR"
if [ -z "$TOKEN" ]; then
  printf '===== %s DISCORD_BOT_TOKEN missing in ~/.claude/channels/discord/.env — report skipped\n' "$(date -Is)" >> "$LOG_DIR/report.log"
  echo "homelab-report: DISCORD_BOT_TOKEN missing — skipped" >&2
  exit 1
fi
DAY=$(date +%F)
PROMPT=$(cat <<'P'
홈랩 일일 점검 리포트를 작성해라. **조회만 하고 아무것도 바꾸지 마라**(켜기·끄기·삭제·재시작 금지, Windows VM이 꺼져 있으면 켜지 마라).
확인할 것:
1. `osadmin server list --all-projects --long`: VM 상태, 잠금 여부. `lab-` 로 시작하는 실습 VM이 있으면 이름·생성 후 경과 시간·상태를 적고 "정리 필요?"로 표시.
2. `osadmin hypervisor stats show`: 메모리·vCPU·디스크 사용량/여유량.
3. `systemctl --user is-active hermes-gateway claude-discord` 와 `journalctl --user -u hermes-gateway --since -24h -p warning --no-pager | tail -n 30` 의 주요 내용.
4. `ssh winpower status`.
5. `~/.local/state/osadmin/audit.log` 에서 지난 24시간 호출 요약(몇 건, 어떤 종류, 실패 몇 건). 삭제·잠금해제가 있었으면 명시.
6. 이 VM의 `df -h /`, `free -h`.
형식: 한국어, 맨 위에 한 줄 요약(✅ 이상 없음 / ⚠️ 확인 필요 n건), 그다음 항목별 짧은 목록. 전체 1500자 이내. secret·토큰은 절대 출력하지 마라.
P
)
# The body goes to Python through a private temp file, not an environment variable:
# a single env string is capped at 128 KiB (E2BIG), and the file is removed on exit.
BODY_FILE=$(mktemp "${TMPDIR:-/tmp}/homelab-report.XXXXXX") || exit 1
chmod 600 "$BODY_FILE"
trap 'rm -f "$BODY_FILE"' EXIT
if [ -n "${HOMELAB_REPORT_BODY_FILE:-}" ]; then
  cat -- "$HOMELAB_REPORT_BODY_FILE" > "$BODY_FILE" || exit 1
  RC=0
  export HOMELAB_REPORT_DRY_RUN=1
else
  cd "$HOME/claude-work" || exit 1
  timeout 900 "$HOME/.local/bin/claude" -p "$PROMPT" --max-turns 40 --output-format text \
    --settings '{"enabledPlugins":{"discord@claude-plugins-official":false}}' < /dev/null > "$BODY_FILE" 2>&1
  RC=$?
  { printf '\n===== %s exit=%s\n' "$(date -Is)" "$RC"; cat "$BODY_FILE"; printf '\n'; } >> "$LOG_DIR/report.log"
fi

# Post with Python: the failure tail and the chunking are done by *characters* on text decoded
# with errors="replace", so a cut never splits a UTF-8 sequence (Korean) or breaks the post.
# HOMELAB_REPORT_DRY_RUN=1 prints the chunk sizes instead of posting (for testing the chunker).
TOKEN="$TOKEN" FORUM_ID="$FORUM_ID" TITLE="홈랩 점검 $DAY" RC="$RC" python3 - "$BODY_FILE" <<'PY'
import json, os, sys, urllib.request

def env(k):  # environ values are bytes underneath; decode them leniently
    return os.fsencode(os.environ.get(k, "")).decode("utf-8", "replace")

LIMIT = 1900                                     # Discord limit: 2000 chars per message
MAX_CHUNKS = 5                                   # never flood the forum post
TRUNC_NOTE = "(이하 생략, 전체 결과: ~/.local/state/homelab-report/report.log)"
rc = env("RC").strip() or "0"
with open(sys.argv[1], "rb") as f:
    body = f.read().decode("utf-8", "replace").strip()
if rc != "0":
    body = ("⚠️ 점검 실행 실패 (exit %s). lab-assistant의 ~/.local/state/homelab-report/report.log 를 확인하세요.\n%s"
            % (rc, body[-800:]))
body = body or "(빈 결과)"

def split(text, limit=LIMIT):
    pieces = []
    for line in text.splitlines(keepends=True):
        while len(line) > limit:                 # an over-long line becomes several pieces
            pieces.append(line[:limit])
            line = line[limit:]
        pieces.append(line)
    chunks, cur = [], ""
    for p in pieces:
        if cur and len(cur) + len(p) > limit:
            chunks.append(cur)
            cur = ""
        cur += p
    chunks.append(cur)
    return [c for c in chunks if c.strip()] or ["(빈 결과)"]

chunks = split(body)
if len(chunks) > MAX_CHUNKS:
    chunks = chunks[:MAX_CHUNKS]
    chunks[-1] = chunks[-1][:LIMIT - len(TRUNC_NOTE) - 1].rstrip("\n") + "\n" + TRUNC_NOTE
if os.environ.get("HOMELAB_REPORT_DRY_RUN") == "1":
    print("dry-run: chunks", len(chunks), "sizes", [len(c) for c in chunks], "tail", repr(chunks[-1][-60:]))
    raise SystemExit(0)

tok, forum = env("TOKEN"), env("FORUM_ID")
def call(url, payload):
    req = urllib.request.Request(url, data=json.dumps(payload).encode(), method="POST",
          headers={"Authorization": f"Bot {tok}", "Content-Type": "application/json", "User-Agent": "homelab-report"})
    return json.load(urllib.request.urlopen(req, timeout=30))
api = "https://discord.com/api/v10"
NO_PINGS = {"parse": []}   # never ping @everyone/roles/users from model output
post = call(f"{api}/channels/{forum}/threads",
            {"name": env("TITLE"), "message": {"content": chunks[0], "allowed_mentions": NO_PINGS}})
for c in chunks[1:]:
    call(f"{api}/channels/{post['id']}/messages", {"content": c, "allowed_mentions": NO_PINGS})
print("posted", post["id"], "chunks", len(chunks))
PY
